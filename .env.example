# Get your key at https://dashboard.exa.ai
EXA_API_KEY=

# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the scoring model (default claude-sonnet-5-5)
# SCORING_MODEL=

# Create a bot with @BotFather; get your chat id by messaging the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: dashboard link at the end of Telegram notifications
# (default https://$RAILWAY_PUBLIC_DOMAIN on Railway, otherwise http://127.0.0.1:8000)
# DASHBOARD_URL=

# Optional: Outlook email updates (`hunt.py outlook-login`, then `hunt.py mail`). The Application (client) ID of
# your own app registration with the delegated Mail.Read permission; see README, Email updates.
# OUTLOOK_CLIENT_ID=
# common (default) accepts personal and work accounts; set consumers or your tenant ID if your registration needs it
# OUTLOOK_TENANT=
