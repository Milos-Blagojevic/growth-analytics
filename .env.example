# Get your key at https://dashboard.exa.ai
EXA_API_KEY=

# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the scoring model (default claude-sonnet-5-5)
# SCORING_MODEL=

# Optional: Jev (TypeSafe) screens out clear misses before Claude in run, mail and news; without it Claude reads
# everything. Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Optional: override the Jev model (default jev-1.14.0, the version the screening thresholds were chosen for)
# JEV_MODEL=

# Create a bot with @BotFather; get your chat id by messaging the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: dashboard link at the end of Telegram notifications
# (default https://$RAILWAY_PUBLIC_DOMAIN on Railway, otherwise http://127.0.0.1:8000).
# `hunt.py monitor-sync` also gives this address to Exa as each monitor's webhook, which Exa requires to be public
# HTTPS; nothing is sent there while a monitor runs. Off Railway, set it before the first monitor-sync.
# DASHBOARD_URL=
#
# The dashboard (`python -m dashboard`) never reads this file. It takes DASHBOARD_PASSWORD, HUNT_SCHEDULE,
# DASHBOARD_URL (as an allowed host name), RAILWAY_PUBLIC_DOMAIN, PORT, POSTHOG_PROJECT_TOKEN, POSTHOG_HOST and
# POSTHOG_SUPPORT_WIDGET from the shell environment only: `export DASHBOARD_PASSWORD=…` or
# `DASHBOARD_PASSWORD=… python -m dashboard`. On Railway they are service variables. The hunt.py jobs it starts load
# .env as usual. POSTHOG_SUPPORT_WIDGET=1 (with both PostHog settings) shows PostHog Support's chat widget on the
# dashboard's pages; what you type in it is sent to PostHog: see dashboard/README.md, Support widget.

# Optional: Outlook, for email updates (`hunt.py outlook-login`, then `hunt.py mail`) and the chat bot. The
# Application (client) ID of your own app registration with the delegated Mail.ReadWrite permission (read mail and
# create drafts; never send); see inbox/README.md, Email updates.
# OUTLOOK_CLIENT_ID=
# common (default) accepts personal and work accounts; set consumers or your tenant ID if your registration needs it
# OUTLOOK_TENANT=

# Optional: Gmail, for the chat bot (`hunt.py gmail-login`, then `hunt.py chat`). The client ID and secret of your
# own "Desktop app" OAuth client in Google Cloud, with the Gmail API enabled; see inbox/README.md, Chat with your mail.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
#
# The chat bot (`hunt.py chat`) answers Telegram messages from TELEGRAM_CHAT_ID only and uses SCORING_MODEL. On
# Railway, set CHAT_BOT=1 so the dashboard keeps it running. A news digest you ask it for uses EXA_API_KEY (and
# TYPESAFE_API_KEY when set).

# Optional: traces of the chat bot's answers in Pydantic Logfire (https://pydantic.dev/logfire): timings, token
# counts, tool names and error types, never the text of messages, emails, drafts or answers. A write token from your
# Logfire project; without it nothing is sent. See inbox/README.md, Chat with your mail.
# LOGFIRE_TOKEN=

# Optional: PostHog (https://posthog.com), for analytics and observability. With both set, hunt.py and
# `python -m prospects` report each command (started, finished, exit code) and each model call (provider, model,
# token counts, seconds); the dashboard, which takes the two from the shell environment, reports what you do on it,
# the pages you open (by route, never the address) and its unhandled errors by type and stack. Every event is the
# owner's, under one fixed id and without a person profile. Never a prompt, an answer, an email, a company, a
# note or an error's message: see clients/README.md, PostHog. The project token (phc_...) from the project's
# settings, and its ingestion host: https://eu.i.posthog.com or https://us.i.posthog.com. Without both nothing is
# sent.
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=
