# Get your key at https://dashboard.exa.ai
EXA_API_KEY=

# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the scoring model (default claude-sonnet-5-5)
# SCORING_MODEL=

# Create a bot with @BotFather; get your chat id by messaging the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: dashboard link at the end of Telegram notifications (default http://127.0.0.1:8000)
# DASHBOARD_URL=
